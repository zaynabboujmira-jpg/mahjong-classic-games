# Public origin used for canonical URLs, sitemaps and OpenGraph tags.
SITE_URL=https://example.com

# Optional integrations. Leave empty to ship no third-party code at all.
# Values are validated at build time; an invalid value is ignored.
# Search Console / Bing Webmaster Tools HTML-tag verification tokens.
PUBLIC_GSC_VERIFICATION=
PUBLIC_BING_VERIFICATION=
# Google Analytics 4 measurement ID (G-XXXXXXX). Loads only after consent.
PUBLIC_GA4_ID=
# Google AdSense publisher ID (ca-pub-0000000000000000) and optional ad unit slot ID.
# Setting the client turns on ad slots and the consent banner, and drops "no ads" claims.
PUBLIC_ADSENSE_CLIENT=
PUBLIC_ADSENSE_SLOT=
