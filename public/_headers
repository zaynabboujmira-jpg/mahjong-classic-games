# Cloudflare Pages headers
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Game pages may be embedded on other sites ("Embed this game"): drop the
# site-wide SAMEORIGIN rule there. Framed pages show only the game.
/mahjong/*
  ! X-Frame-Options
/solitaire/*
  ! X-Frame-Options
/sudoku/*
  ! X-Frame-Options
/minesweeper/*
  ! X-Frame-Options
/word-guess/*
  ! X-Frame-Options
/puzzles/*
  ! X-Frame-Options
/board/*
  ! X-Frame-Options
/cards/*
  ! X-Frame-Options
/arcade/*
  ! X-Frame-Options

# Fingerprinted build assets never change
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/og/*
  Cache-Control: public, max-age=86400

/*.xml
  Cache-Control: public, max-age=3600

# Word lists for Word Guess (fetched on demand)
/words/*
  Cache-Control: public, max-age=604800

# Service worker and its file list must always be fresh
/sw.js
  Cache-Control: no-cache

/precache.json
  Cache-Control: no-cache
