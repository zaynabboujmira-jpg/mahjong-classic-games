---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ogImagePath } from '../lib/seo/meta';
---

<BaseLayout
  title="Page not found"
  description="This page does not exist. Go back to the home page to pick one of 16 free classic games: Mahjong, solitaire, puzzles and arcade."
  image={ogImagePath('home')}
  imageAlt="Free Play Classic"
  noindex
>
  <div class="container-page pt-12 text-center">
    <h1 class="text-4xl font-extrabold">Page not found</h1>
    <p class="text-muted mt-3">That page has wandered off. All 16 games are one click away.</p>
    <div class="mt-6 flex justify-center gap-3">
      <a class="btn btn-primary" href="/">All games</a>
      <a class="btn" href="/mahjong/">Play Mahjong</a>
    </div>
  </div>
</BaseLayout>
