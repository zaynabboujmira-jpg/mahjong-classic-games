---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { liveGames } from '@/data/games.registry';
---
<BaseLayout title="Page not found" description="That page does not exist. Jump straight into a free game of Mahjong Solitaire or browse all layouts and games on the site." path="/404/" noindex>
  <div class="mx-auto max-w-3xl px-4 pt-16 text-center">
    <h1 class="text-4xl font-bold">Page not found</h1>
    <p class="mt-3 text-muted">The tile you were looking for has already been matched.</p>
    <div class="mt-6 flex justify-center gap-3">
      {liveGames().map((g) => (
        <a href={g.path} class="inline-flex min-h-12 items-center rounded-lg bg-accent px-5 font-semibold text-accent-fg">Play {g.name}</a>
      ))}
      <a href="/" class="inline-flex min-h-12 items-center rounded-lg border border-border px-5 font-semibold">Home</a>
    </div>
  </div>
</BaseLayout>
