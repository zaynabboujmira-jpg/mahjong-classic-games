---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ogImagePath } from '../lib/seo/meta';
---

<BaseLayout
  title="Page not found"
  description="This page does not exist. Pick a Mahjong layout or go back to the home page to keep playing free Mahjong Solitaire."
  image={ogImagePath('home')}
  imageAlt="Mahjong & Classic Games"
  noindex
>
  <div class="container-page pt-12 text-center">
    <h1 class="text-4xl font-extrabold">Page not found</h1>
    <p class="text-muted mt-3">That tile seems to have been matched already.</p>
    <div class="mt-6 flex justify-center gap-3">
      <a class="btn btn-primary" href="/">Play Mahjong</a>
      <a class="btn" href="/mahjong/">All layouts</a>
    </div>
  </div>
</BaseLayout>
