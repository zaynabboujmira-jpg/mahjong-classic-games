---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import LevelPage from '../../components/content/LevelPage.astro';
import { ARCADE_COMPARE } from '../../data/compare';
import ColorMemoryGame from '../../components/game/ColorMemoryGame';
import PaddleBallGame from '../../components/game/PaddleBallGame';
import MazeChomperGame from '../../components/game/arcade/MazeChomperGame';
import AlienInvadersGame from '../../components/game/arcade/AlienInvadersGame';
import SpaceRocksGame from '../../components/game/arcade/SpaceRocksGame';
import RiverHopperGame from '../../components/game/arcade/RiverHopperGame';
import FlappyWingGame from '../../components/game/arcade/FlappyWingGame';
import OceanGrowGame from '../../components/game/arcade/OceanGrowGame';

/** One playable page per arcade game in src/content/arcade. */
export const getStaticPaths = (async () => {
  const entries = (await getCollection('arcade')).sort((a, b) => a.data.order - b.data.order);
  return entries.map((entry) => ({ params: { game: entry.data.level }, props: { entry, entries } }));
}) satisfies GetStaticPaths;

interface Props {
  entry: CollectionEntry<'arcade'>;
  entries: CollectionEntry<'arcade'>[];
}
const { entry, entries } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const levels = entries.map((e) => ({ id: e.data.level, name: e.data.name, summary: e.data.summary }));
const isMemory = data.level === 'color-memory';
const GENRES: Record<string, string[]> = {
  'color-memory': ['Memory game', 'Puzzle', 'Arcade'],
  'paddle-ball': ['Arcade', 'Sports', 'Retro'],
  'maze-chomper': ['Arcade', 'Maze', 'Retro'],
  'alien-invaders': ['Arcade', 'Shooter', 'Retro'],
  'space-rocks': ['Arcade', 'Shooter', 'Retro'],
  'river-hopper': ['Arcade', 'Action', 'Retro'],
  'flappy-wing': ['Arcade', 'Casual', 'One-button'],
  'ocean-grow': ['Arcade', 'Casual', 'Action'],
};
const ALT: Record<string, string> = {
  'color-memory': 'Four coloured memory pads',
  'paddle-ball': 'Two paddles and a ball on a green court',
  'maze-chomper': 'A mint critter in a teal maze chased by four Wisps',
  'alien-invaders': 'Rows of pixel aliens above a cannon and shields',
  'space-rocks': 'A vector ship among outlined space rocks',
  'river-hopper': 'A critter hopping across a road and a river',
  'flappy-wing': 'A coral bird flying between stone columns',
  'ocean-grow': 'A gold fish among other fish in the ocean',
};
---

<LevelPage
  game="Arcade"
  base="/arcade/"
  level={{ id: data.level, name: data.name, summary: data.summary }}
  levels={levels}
  data={data}
  genre={GENRES[data.level]!}
  imageAlt={ALT[data.level]!}
  imageKey={`arcade-${data.level}`}
  qa={data.level}
  compare={ARCADE_COMPARE}
  levelsHeading="More arcade games"
  levelTitle={(name) => name}
  howToName={`How to play ${data.name}`}
  more={{
    heading: 'Something calmer?',
    text: 'Mahjong Solitaire is the relaxing classic: match free pairs of tiles to clear the board, with six layouts and solvable deals.',
    href: '/mahjong/',
    label: 'Play Mahjong',
  }}
>
  {isMemory && <ColorMemoryGame slot="game" client:load />}
  {data.level === 'paddle-ball' && <PaddleBallGame slot="game" client:load />}
  {data.level === 'maze-chomper' && <MazeChomperGame slot="game" client:load />}
  {data.level === 'alien-invaders' && <AlienInvadersGame slot="game" client:load />}
  {data.level === 'space-rocks' && <SpaceRocksGame slot="game" client:load />}
  {data.level === 'river-hopper' && <RiverHopperGame slot="game" client:load />}
  {data.level === 'flappy-wing' && <FlappyWingGame slot="game" client:load />}
  {data.level === 'ocean-grow' && <OceanGrowGame slot="game" client:load />}
  <Content />
</LevelPage>
