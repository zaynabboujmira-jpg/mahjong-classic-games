---
import BaseLayout from '../layouts/BaseLayout.astro';
import GameShell from '../components/game/GameShell.astro';
import HowToPlay from '../components/content/HowToPlay.astro';
import Faq from '../components/content/Faq.astro';
import LayoutCard from '../components/content/LayoutCard.astro';
import { layoutPages } from '../lib/mahjong-pages';
import { GAMES } from '../data/games';
import { GENERAL_FAQ, HOW_TO_STEPS } from '../data/mahjong';
import { SITE } from '../data/site';
import { canonicalUrl, ogImagePath } from '../lib/seo/meta';
import { faqPage, graph, howTo, organization, videoGame, webPage, website } from '../lib/seo/schema';

const pages = await layoutPages();
const turtle = pages.find((p) => p.id === 'turtle')!;
const site = Astro.site!;
const origin = new URL('/', site).href;
const url = canonicalUrl('/', site);
const title = 'Free Mahjong Solitaire Online – No Download';
const description = SITE.description;
const image = ogImagePath('home');

const jsonLd = graph(
  organization(origin),
  website(origin),
  webPage(origin, url, title, description),
  videoGame(origin, {
    url,
    name: 'Mahjong Solitaire',
    description,
    image: new URL(image, site).href,
    genre: ['Puzzle', 'Tile-matching', 'Mahjong Solitaire'],
    keywords: ['mahjong', 'mahjong solitaire', 'free mahjong', 'mahjong online'],
  }),
  howTo(url, 'How to play Mahjong Solitaire', HOW_TO_STEPS),
  faqPage(url, GENERAL_FAQ),
);
---

<BaseLayout title={title} description={description} image={image} imageAlt="A Mahjong Solitaire board in the Turtle layout" jsonLd={jsonLd}>
  <GameShell engineId="turtle" layoutName="Turtle" next={turtle.next}>
    <h1 class="text-lg sm:text-xl font-extrabold leading-tight">Mahjong Solitaire – free, no download</h1>
  </GameShell>

  <div class="container-page mt-8">
    <section class="max-w-3xl prose-copy">
      <h2>Play Mahjong Solitaire in your browser</h2>
      <p>
        Mahjong Solitaire is a single-player matching game played with the 144 tiles of a Mahjong set. Tiles are stacked into a
        layout, and you remove them in matching pairs. You can only take a tile that is <strong>free</strong>: nothing on top of
        it, and an open side on its left or right. Clear every tile to win.
      </p>
      <p>
        The board above is the classic Turtle layout. Every deal is built with a guaranteed solution, the tiles stay large and readable
        on phones, and you can play with a mouse, a touch screen or the keyboard.
      </p>
    </section>

    <section aria-labelledby="layouts-heading" class="mt-10">
      <div class="flex items-end justify-between gap-4 mb-4">
        <h2 id="layouts-heading" class="text-2xl font-bold">Choose a layout</h2>
        <a href="/mahjong/" class="text-brand font-semibold hover:underline">All layouts →</a>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          pages.map((p) => (
            <LayoutCard
              engineId={p.id}
              title={p.entry.data.title}
              summary={p.entry.data.summary}
              difficulty={p.entry.data.difficulty}
              tiles={p.tiles}
            />
          ))
        }
      </div>
    </section>

    <HowToPlay />
    <Faq items={GENERAL_FAQ} />

    <section aria-labelledby="more-games" class="mt-12">
      <h2 id="more-games" class="text-2xl font-bold mb-2">More classic games are on the way</h2>
      <p class="text-muted mb-4">{GAMES.filter((g) => g.status === 'planned').map((g) => g.name).join(', ')}.</p>
      <a href="/games/" class="btn">See all games</a>
    </section>
  </div>
</BaseLayout>
