---
import BaseLayout from '../layouts/BaseLayout.astro';
import Faq from '../components/content/Faq.astro';
import GameCatalog from '../components/content/GameCatalog.astro';
import AdSlot from '../components/site/AdSlot.astro';
import { CATALOG, CATEGORIES } from '../data/catalog';
import { FEATURES, SITE } from '../data/site';
import { canonicalUrl, ogImagePath } from '../lib/seo/meta';
import { faqPage, graph, itemList, organization, webPage, website } from '../lib/seo/schema';

const site = Astro.site!;
const origin = new URL('/', site).href;
const url = canonicalUrl('/', site);
const title = `${SITE.name} – 28 Classic Browser Games`;
const description = SITE.description;
const image = ogImagePath('home');

const faq = [
  {
    q: `What is ${SITE.name}?`,
    a: `${SITE.name} is a free website with 28 classic games that play instantly in your browser: Mahjong Solitaire, 4-player Mahjong, Klondike, Spider, FreeCell, Sudoku, Minesweeper, Word Guess, Mini Crossword, Word Search, Number Merge, Nonogram, Memory Match, Chess, Checkers, Dominoes, Four in a Row and eleven retro arcade games including Bubble Shooter, Snake and Brick Breaker.`,
  },
  {
    q: 'Do I need to download anything or sign up?',
    a: 'No. Every game opens straight away in your browser. There is no app to install, no account and no email address to give.',
  },
  {
    q: 'Do the games work on phones and tablets?',
    a: 'Yes. Every game has touch controls and resizes to fit the screen, and the arcade games add on-screen buttons. On a computer you can use the mouse or the keyboard.',
  },
  {
    q: 'Are there ads?',
    a: FEATURES.ads
      ? `${SITE.name} shows a few clearly marked ads, which keep the games free. Ads and analytics only load after you agree in the consent banner, and your scores stay in your own browser.`
      : `No. ${SITE.name} shows no advertising and uses no tracking cookies. Your scores and settings are saved only in your own browser.`,
  },
  {
    q: 'Are the arcade games the original arcade games?',
    a: 'No. They are original games in the classic arcade genres, with their own names, characters, artwork and sound, built to play well on modern phones and computers.',
  },
];

const jsonLd = graph(
  organization(origin),
  website(origin),
  webPage(origin, url, title, description, 'CollectionPage', `${url}#games`),
  itemList(
    url,
    `${SITE.name} games`,
    CATALOG.map((g) => ({ name: g.name, url: new URL(g.play, site).href, description: g.hook })),
  ),
  faqPage(url, faq),
);
---

<BaseLayout title={title} description={description} image={image} imageAlt={`${SITE.name}: 28 classic browser games`} jsonLd={jsonLd} quickSwitch={false}>
  <section class="hero">
    <div class="container-page">
      <h1 class="hero-title">28 classic browser games</h1>
      <p class="hero-sub">Instant play{FEATURES.ads ? '' : ', zero ads'}, ready on mobile and desktop. No download, no sign-up.</p>
      <ul class="hero-facts" aria-label="At a glance">
        <li><strong>28</strong> games</li>
        {FEATURES.ads ? <li><strong>Daily</strong> challenges</li> : <li><strong>0</strong> ads</li>}
        <li><strong>Touch</strong>, mouse &amp; keys</li>
        <li><strong>Free</strong>, always</li>
      </ul>
      <nav class="hero-jump" aria-label="Jump to a category">
        {
          CATEGORIES.map((c) => (
            <a class="btn" href={`#${c.id}`} aria-label={c.name}>
              <span class="sm:hidden">{c.short}</span>
              <span class="hidden sm:inline">{c.name}</span>
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  <div class="container-page">
    <GameCatalog />
    <AdSlot />

    <section class="portal-section" aria-labelledby="why-title">
      <h2 id="why-title" class="portal-title">Why {SITE.name}</h2>
      <ul class="why-grid">
        <li>
          <h3>Instant play</h3>
          <p>The game is the first thing on every page. Pages are small and load in a moment, even on a slow connection.</p>
        </li>
        <li>
          <h3>{FEATURES.ads ? 'No sign-up' : 'No ads, no sign-up'}</h3>
          <p>{FEATURES.ads ? 'No accounts and nothing to install.' : 'No advertising, no accounts and no tracking cookies.'} Scores and settings stay on your device.</p>
        </li>
        <li>
          <h3>Fair and well made</h3>
          <p>Every Mahjong deal can be solved, every Sudoku has one logical solution, and the first Minesweeper click is always safe.</p>
        </li>
        <li>
          <h3>Any screen</h3>
          <p>Touch, mouse and keyboard all work. Boards resize and rotate for phones, with large, readable tiles and cards.</p>
        </li>
      </ul>
    </section>

    <section class="portal-section quick-answer" aria-labelledby="qa-title">
      <h2 id="qa-title" class="portal-title">Quick answer</h2>
      <p>
        <strong>{SITE.name}</strong> ({SITE.domain}) is a free{FEATURES.ads ? '' : ', ad-free'} website with 28 classic games that run in any modern browser on phones,
        tablets and computers: Mahjong Solitaire (6 layouts), 4-player Mahjong against computer opponents (Hong Kong, Chinese and American
        rules), Klondike, Spider and FreeCell solitaire, Sudoku (4 levels), Minesweeper (3 levels), Word Guess (daily and unlimited, 4 to 6
        letters), a daily Mini Crossword, Word Search, Number Merge, Nonogram picture logic, Memory Match, board games against the computer
        (Chess, Checkers, Dominoes and Four in a Row), and eleven retro arcade games including Bubble Shooter, Snake and Brick Breaker.
      </p>
    </section>

    <Faq items={faq} />
  </div>
</BaseLayout>
