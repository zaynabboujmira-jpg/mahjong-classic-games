---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LayoutCard from '@/components/content/LayoutCard.astro';
import { SITE } from '@/data/site';
import { liveGames, plannedGames } from '@/data/games.registry';
import { LAYOUTS } from '@/engines/mahjong/layouts';

const live = liveGames();
const planned = plannedGames();
---
<BaseLayout
  title="Free Mahjong Solitaire & Classic Games Online"
  description={SITE.description}
  path="/"
  withBrand={false}
>
  <section class="mx-auto max-w-6xl px-4 pt-10 pb-6">
    <h1 class="text-3xl font-bold sm:text-4xl">Free Mahjong Solitaire and classic puzzle games</h1>
    <p class="mt-3 max-w-2xl text-lg text-muted">
      Instant play, no download, no sign-up. Every deal is solvable, every board works on a phone, and a large-tile mode keeps it readable for everyone.
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      {live.map((g) => (
        <a href={g.path} class="inline-flex min-h-12 items-center gap-2 rounded-lg bg-accent px-5 text-lg font-semibold text-accent-fg hover:opacity-90">
          <span aria-hidden="true">{g.icon}</span> Play {g.name}
        </a>
      ))}
      <a href="/mahjong/" class="inline-flex min-h-12 items-center rounded-lg border border-border bg-bg-elev px-5 text-lg font-semibold hover:bg-bg">
        Browse layouts
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-6" aria-labelledby="layouts-heading">
    <h2 id="layouts-heading" class="text-2xl font-bold">Mahjong layouts</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {Object.entries(LAYOUTS).map(([slug, m]) => (
        <LayoutCard slug={slug} layout={m.layout} difficulty={m.difficulty} blurb={m.blurb} />
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-6" aria-labelledby="coming-heading">
    <h2 id="coming-heading" class="text-2xl font-bold">Coming soon</h2>
    <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {planned.map((g) => (
        <li class="rounded-lg border border-dashed border-border p-4">
          <p class="font-semibold"><span aria-hidden="true">{g.icon}</span> {g.name}</p>
          <p class="mt-1 text-sm text-muted">{g.tagline}</p>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
