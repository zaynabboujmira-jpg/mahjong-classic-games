---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/data/site';
---
<BaseLayout
  title="Contact"
  description={`Contact ${SITE.name} with bug reports, layout requests or accessibility feedback. We read every message and prioritise anything that stops someone from playing.`}
  path="/contact/"
>
  <article class="prose-game mx-auto max-w-3xl px-4 pt-8">
    <h1 class="text-3xl font-bold">Contact</h1>
    <p class="mt-4">Found a bug, want a layout added, or hit an accessibility problem? Tell us.</p>
    <p>Email: <a href="mailto:hello@example.com">hello@example.com</a> (replace with the real address before launch).</p>
  </article>
</BaseLayout>
