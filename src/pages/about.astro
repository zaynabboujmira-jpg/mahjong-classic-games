---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
import { ogImagePath } from '../lib/seo/meta';
import { graph, organization, website } from '../lib/seo/schema';

const origin = new URL('/', Astro.site!).href;
---

<BaseLayout
  title="About"
  description={`${SITE.name} is a fast, free collection of classic puzzle games: no download, no sign-up, large readable tiles and full keyboard support.`}
  image={ogImagePath('home')}
  imageAlt={SITE.name}
  jsonLd={graph(organization(origin), website(origin))}
>
  <div class="container-page pt-6 prose-copy max-w-3xl">
    <h1 class="text-3xl font-extrabold mb-4">About {SITE.name}</h1>
    <p>
      We make classic puzzle games that load instantly and are comfortable to play for everyone. The game is always the first thing
      on the page: no landing screens, no sign-up and nothing to install.
    </p>
    <h2>What we care about</h2>
    <ul>
      <li><strong>Fair games.</strong> Every Mahjong deal is generated with a guaranteed solution.</li>
      <li>
        <strong>Readable on any screen.</strong> Tiles stay at a comfortable tap size on phones, and the board rotates to fit portrait
        screens.
      </li>
      <li><strong>Accessible.</strong> Keyboard play, screen-reader announcements, dark mode and reduced motion are built in.</li>
      <li><strong>Private.</strong> No tracking cookies. Your best times stay on your own device.</li>
    </ul>
  </div>
</BaseLayout>
