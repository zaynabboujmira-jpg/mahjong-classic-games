---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import KlondikeGame from '../../components/game/KlondikeGame';
import SpiderGame from '../../components/game/SpiderGame';
import FreeCellGame from '../../components/game/FreeCellGame';
import PyramidGame from '../../components/game/PyramidGame';
import { FAMOUS_DEALS } from '../../data/freecell';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import Faq from '../../components/content/Faq.astro';
import EmbedGame from '../../components/content/EmbedGame.astro';
import QuickAnswer from '../../components/content/QuickAnswer.astro';
import CompareTable from '../../components/content/CompareTable.astro';
import { SOLITAIRE_COMPARE } from '../../data/compare';
import { canonicalUrl, ogImagePath } from '../../lib/seo/meta';
import { breadcrumbs, faqPage, graph, howTo, organization, videoGame, webPage, website } from '../../lib/seo/schema';

/** One page per solitaire variant in src/content/solitaire (Klondike today; Spider and FreeCell later). */
export const getStaticPaths = (async () => {
  const variants = await getCollection('solitaire');
  return variants.map((entry) => ({ params: { variant: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

interface Props {
  entry: CollectionEntry<'solitaire'>;
}
const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const other = { name: 'Play Mahjong', href: '/mahjong/' };

const site = Astro.site!;
const origin = new URL('/', site).href;
const url = canonicalUrl(Astro.url.pathname, site);
const image = ogImagePath(`solitaire-${entry.id}`);
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Solitaire', href: '/solitaire/' },
  { name: data.title.replace(' Solitaire', ''), href: `/solitaire/${entry.id}/` },
];

const jsonLd = graph(
  organization(origin),
  website(origin),
  webPage(origin, url, data.title, data.description),
  breadcrumbs(url, crumbs.map((c) => ({ name: c.name, url: new URL(c.href, site).href }))),
  videoGame(origin, {
    url,
    name: data.title,
    description: data.description,
    image: new URL(image, site).href,
    genre: ['Card game', 'Solitaire', 'Patience'],
    keywords: data.keywords,
  }),
  howTo(url, `How to play ${data.title}`, data.howTo),
  faqPage(url, data.faq),
);
---

<BaseLayout title={data.title} description={data.description} image={image} imageAlt={`${data.title} cards on a green table`} jsonLd={jsonLd} embeddable>
  <div class="game-shell">
    <div class="container-page pt-2 pb-1 game-head">
      <Breadcrumbs items={crumbs} />
      <h1 class="text-lg sm:text-xl font-extrabold leading-tight mt-0.5">{data.h1}</h1>
    </div>
    {data.engine === 'klondike' && <KlondikeGame client:load defaultDraw={data.defaultDraw ?? 1} otherGame={other} />}
    {data.engine === 'spider' && <SpiderGame client:load defaultSuits={data.defaultSuits ?? 1} otherGame={other} />}
    {data.engine === 'freecell' && <FreeCellGame client:load otherGame={other} />}
    {data.engine === 'pyramid' && <PyramidGame client:load />}
  </div>

  <div class="container-page mt-2">
    <EmbedGame name={data.h1.split(/ [–—:-] /)[0]!} />
    <QuickAnswer id={data.engine} />
    <CompareTable table={SOLITAIRE_COMPARE} current={Astro.url.pathname} />
    <article class="prose-copy max-w-3xl mt-6">
      <Content />
    </article>

    <section id="how-to-play" aria-labelledby="how-heading" class="mt-10">
      <h2 id="how-heading" class="text-2xl font-bold mb-4">How to play {data.title}</h2>
      <ol class="grid gap-3 sm:grid-cols-2">
        {
          data.howTo.map((step, i) => (
            <li class="rounded-xl border border-border bg-card p-4 flex gap-3">
              <span class="shrink-0 grid place-items-center size-8 rounded-full bg-brand text-brand-fg font-bold">{i + 1}</span>
              <div>
                <h3 class="font-semibold">{step.name}</h3>
                <p class="text-muted text-sm mt-1">{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    {
      data.engine === 'freecell' && (
        <section aria-labelledby="deals-heading" class="mt-10">
          <h2 id="deals-heading" class="text-2xl font-bold mb-2">Play a numbered deal</h2>
          <p class="text-muted mb-4">
            Every deal has a number, the same as in the classic Windows game. Share a deal by its link, or start from one of these:
          </p>
          <ul class="flex flex-wrap gap-2">
            {FAMOUS_DEALS.map((d) => (
              <li>
                <a class="btn" href={`/solitaire/freecell/deal/${d.deal}/`}>
                  #{d.deal}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <Faq items={data.faq} />

    <section aria-labelledby="more-games" class="mt-12">
      <h2 id="more-games" class="text-2xl font-bold mb-2">Prefer tiles?</h2>
      <p class="text-muted mb-4">Try Mahjong Solitaire: six layouts, and every deal is guaranteed to be solvable.</p>
      <a class="btn btn-primary" href="/mahjong/">Play Mahjong</a>
    </section>
  </div>
</BaseLayout>
