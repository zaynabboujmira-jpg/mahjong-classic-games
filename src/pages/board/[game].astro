---
import { getCollection, type CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BoardPage from '../../components/content/BoardPage.astro';

/** One page per board game in src/content/board. */
export const getStaticPaths = (async () => {
  const entries = (await getCollection('board')).sort((a, b) => a.data.order - b.data.order);
  return entries.map((entry) => ({ params: { game: entry.data.level }, props: { entry, entries } }));
}) satisfies GetStaticPaths;

interface Props {
  entry: CollectionEntry<'board'>;
  entries: CollectionEntry<'board'>[];
}
---

<BoardPage {...Astro.props} />
