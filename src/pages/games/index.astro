---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import { GAMES } from '../../data/games';
import { canonicalUrl, ogImagePath } from '../../lib/seo/meta';
import { breadcrumbs, graph, organization, webPage, website } from '../../lib/seo/schema';

const site = Astro.site!;
const origin = new URL('/', site).href;
const url = canonicalUrl(Astro.url.pathname, site);
const title = 'All Free Classic Games';
const description =
  'Every game on the site: Mahjong Solitaire today, with Klondike, Spider Solitaire, FreeCell, Sudoku and Minesweeper coming soon. Free, no download.';
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'All games', href: '/games/' },
];
const jsonLd = graph(
  organization(origin),
  website(origin),
  webPage(origin, url, title, description),
  breadcrumbs(url, crumbs.map((c) => ({ name: c.name, url: new URL(c.href, site).href }))),
);
---

<BaseLayout title={title} description={description} image={ogImagePath('home')} imageAlt="Mahjong & Classic Games" jsonLd={jsonLd}>
  <div class="container-page pt-4">
    <Breadcrumbs items={crumbs} />
    <h1 class="text-3xl sm:text-4xl font-extrabold mt-2">All games</h1>
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 mt-6">
      {
        GAMES.map((g) => (
          <li class="rounded-xl border border-border bg-card p-5 flex flex-col">
            <div class="flex items-center justify-between gap-2">
              <h2 class="font-bold text-lg">
                {g.href ? (
                  <a class="hover:text-brand" href={g.href}>
                    {g.name}
                  </a>
                ) : (
                  g.name
                )}
              </h2>
              {g.status === 'planned' && (
                <span class="text-xs font-semibold rounded-full px-2 py-0.5 border border-border text-muted">Coming soon</span>
              )}
            </div>
            <p class="text-sm text-muted mt-2 flex-1">{g.blurb}</p>
            {g.href && (
              <a class="btn btn-primary mt-4 self-start" href={g.href}>
                Play now
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
