---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import GameCatalog from '../../components/content/GameCatalog.astro';
import { CATALOG } from '../../data/catalog';
import { FEATURES, SITE } from '../../data/site';
import { canonicalUrl, ogImagePath } from '../../lib/seo/meta';
import { breadcrumbs, graph, itemList, organization, webPage, website } from '../../lib/seo/schema';

const site = Astro.site!;
const origin = new URL('/', site).href;
const url = canonicalUrl(Astro.url.pathname, site);
const title = 'All 16 Free Classic Games';
const description =
  'Every game on Free Play Classic: Mahjong, 4-player Mahjong, Klondike, Spider, FreeCell, Sudoku, Minesweeper, Word Guess and eight arcade games.';
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'All games', href: '/games/' },
];
const jsonLd = graph(
  organization(origin),
  website(origin),
  webPage(origin, url, title, description, 'CollectionPage', `${url}#games`),
  breadcrumbs(url, crumbs.map((c) => ({ name: c.name, url: new URL(c.href, site).href }))),
  itemList(url, `All ${SITE.name} games`, CATALOG.map((g) => ({ name: g.name, url: new URL(g.play, site).href, description: g.hook }))),
);
---

<BaseLayout title={title} description={description} image={ogImagePath('home')} imageAlt={SITE.name} jsonLd={jsonLd} quickSwitch={false}>
  <div class="container-page pt-4">
    <Breadcrumbs items={crumbs} />
    <h1 class="text-3xl sm:text-4xl font-extrabold mt-2">All games</h1>
    <p class="text-muted mt-2 max-w-2xl">All 16 games play instantly in your browser, with {FEATURES.ads ? 'no download' : 'no ads'} and no sign-up.</p>
    <GameCatalog />
  </div>
</BaseLayout>
