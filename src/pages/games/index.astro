---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro';
import { GAMES } from '@/data/games.registry';
import { breadcrumbs } from '@/lib/seo/schema';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'All games', path: '/games/' },
];
const siteUrl = (Astro.site ?? new URL('https://example.com')).toString();
---
<BaseLayout
  title="All Games"
  description="Every free game on the site in one place: Mahjong Solitaire with multiple layouts today, with Klondike, Spider, FreeCell, Sudoku and Minesweeper on the way. No download, no sign-up."
  path="/games/"
  schema={[breadcrumbs(siteUrl, crumbs)]}
>
  <div class="mx-auto max-w-6xl px-4 pt-6">
    <Breadcrumbs {crumbs} />
    <h1 class="mt-2 text-3xl font-bold">All games</h1>
    <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {GAMES.map((g) => (
        <li class={`rounded-xl border border-border p-5 ${g.status === 'live' ? 'bg-bg-elev' : 'border-dashed opacity-80'}`}>
          <p class="text-3xl" aria-hidden="true">{g.icon}</p>
          <h2 class="mt-2 text-xl font-bold">
            {g.status === 'live' ? <a href={g.path} class="hover:underline">{g.name}</a> : g.name}
          </h2>
          <p class="text-sm text-muted">{g.genre}</p>
          <p class="mt-2">{g.tagline}</p>
          {g.status === 'live' ? (
            <a href={g.path} class="mt-4 inline-flex min-h-11 items-center rounded-md bg-accent px-4 font-semibold text-accent-fg">Play now</a>
          ) : (
            <p class="mt-4 text-sm font-semibold text-muted">Coming soon</p>
          )}
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
