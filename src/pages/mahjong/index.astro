---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import CompareTable from '../../components/content/CompareTable.astro';
import { mahjongLayoutCompare } from '../../lib/mahjong-pages';
import HowToPlay from '../../components/content/HowToPlay.astro';
import Faq from '../../components/content/Faq.astro';
import LayoutCard from '../../components/content/LayoutCard.astro';
import { layoutPages } from '../../lib/mahjong-pages';
import { GENERAL_FAQ, HOW_TO_STEPS } from '../../data/mahjong';
import { GUIDE_PATH, SCORECARD_PDF } from '../../data/american-guide';
import { canonicalUrl, ogImagePath } from '../../lib/seo/meta';
import { breadcrumbs, faqPage, graph, howTo, organization, webPage, website } from '../../lib/seo/schema';

const pages = await layoutPages();
const tableRules = (await getCollection('tableMahjong')).sort((a, b) => a.data.order - b.data.order);
const site = Astro.site!;
const origin = new URL('/', site).href;
const url = canonicalUrl(Astro.url.pathname, site);
const title = 'Mahjong Solitaire Layouts';
const description =
  'Choose from six free Mahjong Solitaire layouts: Turtle, Dragon, Pyramid, Fortress, Butterfly and Fish. Every deal is solvable. Play instantly, no download.';
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Mahjong', href: '/mahjong/' },
];

const jsonLd = graph(
  organization(origin),
  website(origin),
  webPage(origin, url, title, description, 'CollectionPage', `${url}#layouts`),
  breadcrumbs(url, crumbs.map((c) => ({ name: c.name, url: new URL(c.href, site).href }))),
  {
    '@type': 'ItemList',
    '@id': `${url}#layouts`,
    name: title,
    itemListElement: pages.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: new URL(`/mahjong/${p.id}/`, site).href,
      name: p.entry.data.title,
    })),
  },
  howTo(url, 'How to play Mahjong Solitaire', HOW_TO_STEPS),
  faqPage(url, GENERAL_FAQ),
);
---

<BaseLayout title={title} description={description} image={ogImagePath('mahjong')} imageAlt="Six Mahjong Solitaire layouts" jsonLd={jsonLd}>
  <div class="container-page pt-4">
    <Breadcrumbs items={crumbs} />
    <h1 class="text-3xl sm:text-4xl font-extrabold mt-2">Mahjong Solitaire layouts</h1>
    <p class="text-muted mt-2 max-w-2xl">
      Pick a layout and start playing straight away. Every deal is generated with a guaranteed solution, tiles stay large on phones,
      and your best time for each layout is saved on your device.
    </p>

    <h2 class="text-2xl font-bold mt-6">Pick a layout</h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 mt-3">
      {
        pages.map((p) => (
          <LayoutCard
            engineId={p.id}
            title={p.entry.data.title}
            summary={p.entry.data.summary}
            difficulty={p.entry.data.difficulty}
            tiles={p.tiles}
          />
        ))
      }
    </div>

    <CompareTable table={mahjongLayoutCompare(pages)} />

    <section aria-labelledby="table-heading" class="mt-10">
      <h2 id="table-heading" class="text-2xl font-bold mb-2">Play 4-player Mahjong against bots</h2>
      <p class="text-muted mb-4 max-w-2xl">Prefer the table game? Sit down with three computer players and build four sets and a pair, or a hand from the card.</p>
      <ul class="grid gap-4 sm:grid-cols-3">
        {
          tableRules.map((t) => (
            <li class="rounded-xl border border-border bg-card p-5 flex flex-col">
              <h3 class="font-bold text-lg">
                <a class="hover:text-brand" href={`/mahjong/${t.data.level}/`}>
                  {t.data.name} Mahjong
                </a>
              </h3>
              <p class="text-sm text-muted mt-2 flex-1">{t.data.summary}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="guide-callout" aria-labelledby="guide-heading">
      <h2 id="guide-heading">Free American Mahjong guide &amp; printable scorecard</h2>
      <p>
        Learning American Mahjong? Our free guide explains the 9 hand categories, exposed (X) and concealed (C) hands, the no-joker star and
        point values from 25 to 75, with a scorecard you can print for your group.
      </p>
      <div class="guide-callout-actions">
        <a class="btn btn-primary" href={GUIDE_PATH}>Open the free guide</a>
        <a class="btn" href={SCORECARD_PDF} download="printable-mahjong-scorecard.pdf">Download the scorecard (PDF)</a>
      </div>
    </section>

    <HowToPlay />
    <Faq items={GENERAL_FAQ} />
  </div>
</BaseLayout>
