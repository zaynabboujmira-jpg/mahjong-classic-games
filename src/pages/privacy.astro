---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
import { ogImagePath } from '../lib/seo/meta';
---

<BaseLayout
  title="Privacy"
  description={`How ${SITE.name} handles your data: no accounts, no tracking cookies, game settings and best times stored only in your own browser.`}
  image={ogImagePath('home')}
  imageAlt={SITE.name}
>
  <div class="container-page pt-6 prose-copy max-w-3xl">
    <h1 class="text-3xl font-extrabold mb-4">Privacy</h1>
    <p>
      {SITE.name} does not ask for an account and does not set tracking cookies. Your game settings and best times are saved in your
      browser's local storage on your own device and are never sent to us. Clearing your browser data removes them.
    </p>
    <h2>Hosting</h2>
    <p>
      The site is served by Cloudflare. Like any web host, Cloudflare processes technical data such as IP addresses to deliver pages and
      protect the service.
    </p>
    <h2>Changes</h2>
    <p>If we add analytics or advertising in the future, this page will be updated before that happens.</p>
  </div>
</BaseLayout>
