---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import LevelPage from './LevelPage.astro';
import { PUZZLE_COMPARE } from '../../data/compare';
import NumberMergeGame from '../game/NumberMergeGame';
import MemoryMatchGame from '../game/MemoryMatchGame';
import NonogramGame from '../game/NonogramGame';
import WordSearchGame from '../game/WordSearchGame';
import MiniCrosswordGame from '../game/MiniCrosswordGame';
import WordBuilderGame from '../game/WordBuilderGame';

/** A puzzle page under /puzzles/. */
interface Props {
  entry: CollectionEntry<'puzzles'>;
  entries: CollectionEntry<'puzzles'>[];
}
const { entry, entries } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const levels = entries.map((e) => ({ id: e.data.level, name: e.data.name, summary: e.data.summary, }));
const GENRES: Record<string, string[]> = {
  'number-merge': ['Puzzle', 'Number game', 'Casual'],
  'memory-match': ['Memory game', 'Card game', 'Puzzle'],
  nonogram: ['Puzzle', 'Logic puzzle', 'Picture puzzle'],
  'word-search': ['Word game', 'Puzzle', 'Casual'],
  'mini-crossword': ['Word game', 'Crossword', 'Puzzle'],
  'word-builder': ['Word game', 'Puzzle', 'Casual'],
};
const ALT: Record<string, string> = {
  'number-merge': 'A 4×4 board of number tiles up to 2048',
  'memory-match': 'A grid of face-down cards with matched pairs turned up',
  nonogram: 'A nonogram grid with number clues and a filled picture',
  'word-search': 'A letter grid with found words marked in colour',
  'mini-crossword': 'A small crossword grid with numbered squares',
  'word-builder': 'Seven letters on a wheel with a word being spelled',
};
const more = {
  heading: 'Like logic puzzles?',
  text: 'Sudoku has four levels, each puzzle with exactly one solution and no guessing needed.',
  href: '/sudoku/',
  label: 'Play Sudoku',
};
---

<LevelPage
  game="Puzzles"
  base="/puzzles/"
  level={{ id: data.level, name: data.name, summary: data.summary }}
  levels={levels}
  data={data}
  genre={GENRES[data.level]!}
  imageAlt={ALT[data.level]!}
  imageKey={`puzzles-${data.level}`}
  qa={data.level}
  compare={PUZZLE_COMPARE}
  levelsHeading="More puzzles and word games"
  levelTitle={(name) => name}
  howToName={`How to play ${data.name}`}
  more={more}
>
  {data.level === 'number-merge' && <NumberMergeGame slot="game" client:load />}
  {data.level === 'memory-match' && <MemoryMatchGame slot="game" client:load />}
  {data.level === 'nonogram' && <NonogramGame slot="game" client:load />}
  {data.level === 'word-search' && <WordSearchGame slot="game" client:load />}
  {data.level === 'mini-crossword' && <MiniCrosswordGame slot="game" client:load />}
  {data.level === 'word-builder' && <WordBuilderGame slot="game" client:load />}
  <Content />
</LevelPage>
