---
import { getCollection, render } from 'astro:content';
import LevelPage from './LevelPage.astro';
import WordGuessGame from '../game/WordGuessGame';
import { WORD_COMPARE } from '../../data/compare';

/** A Word Guess page for one word length; the 5-letter game lives at /word-guess/ itself. */
interface Props {
  level: '4-letters' | '5-letters' | '6-letters';
}
const { level } = Astro.props;
const entries = (await getCollection('word')).sort((a, b) => a.data.order - b.data.order);
const entry = entries.find((e) => e.data.level === level)!;
const { data } = entry;
const { Content } = await render(entry);
const pathOf = (id: string) => (id === '5-letters' ? '/word-guess/' : `/word-guess/${id}/`);
const levels = entries.map((e) => ({ id: e.data.level, name: e.data.name, summary: e.data.summary, path: pathOf(e.data.level) }));
const length = Number(level[0]) as 4 | 5 | 6;
---

<LevelPage
  game="Word Guess"
  base="/word-guess/"
  level={{ id: data.level, name: data.name, summary: data.summary, path: pathOf(data.level) }}
  levels={levels}
  data={data}
  genre={['Word game', 'Puzzle', 'Word puzzle']}
  imageAlt={`A ${length}-letter Word Guess grid with coloured tiles`}
  imageKey={`word-${length}`}
  qa="word-guess"
  qaExtra={[{ label: 'This page', value: `${length}-letter words, six guesses, daily word plus unlimited play` }]}
  compare={WORD_COMPARE}
  levelsHeading="Other word lengths"
  levelTitle={(name) => `Word Guess, ${name}`}
  howToName={`How to play Word Guess (${length} letters)`}
  more={{
    heading: 'Prefer numbers to letters?',
    text: 'Sudoku is pure logic with digits: four levels, one solution each, and hints when you need them.',
    href: '/sudoku/',
    label: 'Play Sudoku',
  }}
>
  <WordGuessGame slot="game" client:load defaultLength={length} />
  <Content />
</LevelPage>
