---
/**
 * "More classic games" quick switch: every live game with a small inline SVG
 * icon. Pure HTML in a native <details> (no JS, no images to fetch), rendered
 * below the game so it never affects the first screen.
 */
interface Props {
  current: string;
}
const { current } = Astro.props;

const S = 'fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"';
const GAMES = [
  { href: '/mahjong/', name: 'Mahjong', icon: `<rect x="5" y="3" width="13" height="17" rx="2" ${S}/><path d="M9 8h5M11.5 8v8M9 12h5" ${S}/>` },
  { href: '/mahjong/hong-kong/', name: '4-Player Mahjong', icon: `<rect x="2" y="7" width="6" height="9" rx="1.5" ${S}/><rect x="9" y="7" width="6" height="9" rx="1.5" ${S}/><rect x="16" y="7" width="6" height="9" rx="1.5" ${S}/>` },
  { href: '/solitaire/klondike/', name: 'Klondike', icon: `<rect x="4" y="4" width="11" height="16" rx="2" ${S}/><path d="M15 6l4 1.2-3 12" ${S}/><path d="M9.5 9.5l2 2.5-2 2.5-2-2.5z" fill="currentColor"/>` },
  { href: '/solitaire/spider/', name: 'Spider', icon: `<circle cx="12" cy="12" r="3" ${S}/><path d="M12 9V4M12 15v5M9 12H3M15 12h6M9.5 9.5 5 5M14.5 9.5 19 5M9.5 14.5 5 19M14.5 14.5 19 19" ${S}/>` },
  { href: '/solitaire/freecell/', name: 'FreeCell', icon: `<rect x="3" y="3" width="8" height="8" rx="1.5" ${S}/><rect x="13" y="3" width="8" height="8" rx="1.5" ${S}/><rect x="3" y="13" width="8" height="8" rx="1.5" ${S}/><rect x="13" y="13" width="8" height="8" rx="1.5" ${S}/>` },
  { href: '/sudoku/', name: 'Sudoku', icon: `<rect x="3" y="3" width="18" height="18" rx="2" ${S}/><path d="M9 3v18M15 3v18M3 9h18M3 15h18" ${S}/>` },
  { href: '/minesweeper/', name: 'Minesweeper', icon: `<circle cx="12" cy="13" r="5" ${S}/><path d="M12 4v3M12 19v2M4 13h3M17 13h3M6.5 7.5l2 2M15.5 16.5l2 2M17.5 7.5l-2 2M8.5 16.5l-2 2" ${S}/>` },
  { href: '/word-guess/', name: 'Word Guess', icon: `<rect x="2" y="8" width="6" height="8" rx="1" ${S}/><rect x="9" y="8" width="6" height="8" rx="1" fill="currentColor" opacity=".35" ${S}/><rect x="16" y="8" width="6" height="8" rx="1" ${S}/>` },
  { href: '/arcade/color-memory/', name: 'Color Memory', icon: `<rect x="3" y="3" width="8" height="8" rx="2" fill="#0f9b8e"/><rect x="13" y="3" width="8" height="8" rx="2" fill="#c0264d"/><rect x="3" y="13" width="8" height="8" rx="2" fill="#c77c0a"/><rect x="13" y="13" width="8" height="8" rx="2" fill="#4338ca"/>` },
  { href: '/arcade/paddle-ball/', name: 'Paddle Ball', icon: `<path d="M4 7v10M20 7v10" ${S}/><circle cx="13" cy="10" r="2" fill="currentColor"/><path d="M12 3v2M12 19v2M12 9v0M12 14v1" ${S}/>` },
  { href: '/arcade/maze-chomper/', name: 'Maze Chomper', icon: `<path d="M3 3h18v18H3zM7 3v6M3 13h6M13 21v-6M17 7h4M11 7v4h4" ${S}/><circle cx="16" cy="16" r="2" fill="currentColor"/>` },
  { href: '/arcade/alien-invaders/', name: 'Alien Invaders', icon: `<path d="M7 5h10v3h2v5h-2v3h-2v-2H9v2H7v-3H5V8h2z" ${S}/><path d="M9 9h1M14 9h1" ${S}/><path d="M12 19v2" ${S}/>` },
  { href: '/arcade/space-rocks/', name: 'Space Rocks', icon: `<path d="M5 9l4-5 7 1 4 6-3 7-8 2-5-5z" ${S}/><path d="M17 3l3 3" ${S}/>` },
  { href: '/arcade/river-hopper/', name: 'River Hopper', icon: `<path d="M2 15c2-2 4 2 6 0s4 2 6 0 4 2 6 0" ${S}/><circle cx="12" cy="8" r="4" ${S}/><circle cx="9.5" cy="4.5" r="1.5" ${S}/><circle cx="14.5" cy="4.5" r="1.5" ${S}/>` },
  { href: '/arcade/flappy-wing/', name: 'Flappy Wing', icon: `<path d="M3 3h4v6H3zM3 16h4v5H3z" ${S}/><circle cx="15" cy="12" r="4" ${S}/><path d="M19 12l3 1-3 1" ${S}/>` },
  { href: '/arcade/ocean-grow/', name: 'Ocean Grow', icon: `<path d="M3 12c3-5 9-6 13-2l5-3v10l-5-3c-4 4-10 3-13-2z" ${S}/><circle cx="8" cy="11" r="1" fill="currentColor"/>` },
];
/** The game this page belongs to: the 4-player rule sets share one entry; otherwise the longest matching link. */
const active = /^\/mahjong\/(hong-kong|american|chinese)\//.test(current)
  ? '/mahjong/hong-kong/'
  : GAMES.filter((g) => current.startsWith(g.href)).sort((a, b) => b.href.length - a.href.length)[0]?.href;
---

<details class="quick-switch container-page" open>
  <summary>More classic games</summary>
  <nav aria-label="More classic games">
    <ul>
      {
        GAMES.map((g) => (
          <li>
            <a href={g.href} aria-current={g.href === active ? 'page' : undefined}>
              <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" set:html={g.icon} />
              <span>{g.name}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</details>
