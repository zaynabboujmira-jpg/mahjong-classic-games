---
import { CATALOG } from '../../data/catalog';

/**
 * "More classic games" quick switch: every live game with a small inline SVG
 * icon. Pure HTML in a native <details> (no JS, no images to fetch), rendered
 * below the game so it never affects the first screen.
 */
interface Props {
  current: string;
}
const { current } = Astro.props;

/** Every game, linked to its own hub (layouts or levels) or, where the hub is shared, its own page. */
const SHARED_HUBS = ['/arcade/', '/solitaire/'];
const GAMES = CATALOG.map((g) => ({ href: SHARED_HUBS.includes(g.hub) ? g.play : g.hub, name: g.name.replace(' Solitaire', ''), icon: g.icon }));
/** The game this page belongs to: the 4-player rule sets share one entry; otherwise the longest matching link. */
const active = /^\/mahjong\/(hong-kong|american|chinese)\//.test(current)
  ? '/mahjong/hong-kong/'
  : GAMES.filter((g) => current.startsWith(g.href)).sort((a, b) => b.href.length - a.href.length)[0]?.href;
---

<details class="quick-switch container-page" open>
  <summary>More classic games</summary>
  <nav aria-label="More classic games">
    <ul>
      {
        GAMES.map((g) => (
          <li>
            <a href={g.href} aria-current={g.href === active ? 'page' : undefined}>
              <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" set:html={g.icon} />
              <span>{g.name}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</details>
