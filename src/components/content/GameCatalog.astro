---
import { CATALOG, CATEGORIES } from '../../data/catalog';

/** All 22 games in their three categories (H2 per category, H3 per game); used by the homepage and /games/. */
---

{
  CATEGORIES.map((c) => (
    <section id={c.id} class="portal-section" aria-labelledby={`${c.id}-title`}>
      <h2 id={`${c.id}-title`} class="portal-title">
        {c.name}
      </h2>
      <p class="text-muted mb-4 max-w-2xl">{c.blurb}</p>
      <ul class="game-grid">
        {CATALOG.filter((g) => g.category === c.id).map((g) => (
          <li>
            <a class="game-card" href={g.play}>
              <span class="game-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="30" height="30" set:html={g.icon} />
              </span>
              <span class="game-body">
                <h3 class="game-name">{g.name}</h3>
                <p class="game-hook">{g.hook}</p>
                <span class="game-badges">
                  {g.badges.map((b) => (
                    <span class="badge">{b}</span>
                  ))}
                </span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))
}
