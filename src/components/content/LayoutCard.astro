---
import type { Layout } from '@/engines/mahjong/types';
interface Props {
  slug: string;
  layout: Layout;
  difficulty: string;
  blurb: string;
}
const { slug, layout, difficulty, blurb } = Astro.props;

// Build a tiny static SVG preview of the layout so the gallery needs no JS.
const u = 6;
const w = (layout.width + layout.layers) * u;
const h = (layout.height + layout.layers) * u * 1.3;
const rects = layout.slots.map((s) => {
  const x = (s.x + layout.layers - s.z * 0.5) * u;
  const y = (s.y + layout.layers - s.z * 0.5) * u * 1.3;
  return `<rect x="${x.toFixed(1)}" y="${y.toFixed(1)}" width="${2 * u - 1}" height="${(2 * u * 1.3 - 1).toFixed(1)}" rx="1.5" fill="#fffdf5" stroke="#8c8674" stroke-width="0.6"/>`;
});
const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${w} ${h}" role="img" aria-label="${layout.name} layout preview">${rects.join('')}</svg>`;
const badge = { easy: 'bg-green-600', medium: 'bg-amber-600', hard: 'bg-red-700' }[difficulty] ?? 'bg-slate-600';
---
<a href={`/mahjong/${slug}/`} class="group block overflow-hidden rounded-xl border border-border bg-bg-elev transition hover:shadow-lg">
  <div class="bg-felt p-3" set:html={svg} />
  <div class="p-4">
    <div class="flex items-center justify-between gap-2">
      <h3 class="text-lg font-bold group-hover:underline">{layout.name}</h3>
      <span class={`rounded px-2 py-0.5 text-xs font-semibold uppercase text-white ${badge}`}>{difficulty}</span>
    </div>
    <p class="mt-1 text-sm text-muted">{layout.slots.length} tiles · {layout.layers} layers</p>
    <p class="mt-2 text-sm">{blurb}</p>
  </div>
</a>
