---
import { getLayout } from '../../engines/mahjong/layouts';
import { layoutPreviewSvg } from '../../lib/layout-preview';

interface Props {
  engineId: string;
  title: string;
  summary: string;
  difficulty: string;
  tiles: number;
  current?: boolean;
}
const { engineId, title, summary, difficulty, tiles, current = false } = Astro.props;
const layout = getLayout(engineId);
const svg = layout ? layoutPreviewSvg(layout.slots, { tile: 10 }) : '';
---

<a
  href={`/mahjong/${engineId}/`}
  class:list={[
    'group flex flex-col rounded-xl border bg-card p-4 transition-colors hover:border-brand no-underline text-fg',
    current ? 'border-brand ring-2 ring-brand/30' : 'border-border',
  ]}
  aria-current={current ? 'page' : undefined}
>
  <div class="aspect-[16/9] rounded-lg grid place-items-center p-3 [&>svg]:max-h-full [&>svg]:w-full" style="background: radial-gradient(ellipse at 50% 35%, var(--felt-1), var(--felt-2));" set:html={svg} />
  <div class="mt-3 flex items-center justify-between gap-2">
    <h3 class="font-bold text-lg group-hover:text-brand">{title.replace(' Mahjong Solitaire', '')}</h3>
    <span class="text-xs font-semibold rounded-full px-2 py-0.5 border border-border text-muted">{difficulty}</span>
  </div>
  <p class="text-sm text-muted mt-1">{summary}</p>
  <p class="text-xs text-muted mt-2">{tiles} tiles</p>
</a>
