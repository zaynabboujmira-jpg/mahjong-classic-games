---
/**
 * Board-first page: the playable game is the first thing in the viewport,
 * SEO content (intro, how-to, FAQ, related) follows below the fold.
 */
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro';
import GameIsland from '@/components/game/GameIsland';
import MoreGamesRail from '@/components/game/MoreGamesRail.astro';
import HowToPlay from '@/components/content/HowToPlay.astro';
import Faq from '@/components/content/Faq.astro';
import { breadcrumbs, faqPage, game as gameSchema, howTo, type Crumb, type FaqItem } from '@/lib/seo/schema';

interface Props {
  title: string;
  description: string;
  path: string;
  h1: string;
  intro: string;
  genre: string;
  gameplayVariant?: string;
  crumbs: Crumb[];
  steps?: string[];
  stepsTitle?: string;
  faq: FaqItem[];
  layoutSlug: string;
  updated: Date;
}
const { title, description, path, h1, intro, genre, gameplayVariant, crumbs, steps, stepsTitle, faq, layoutSlug, updated } = Astro.props;
const siteUrl = (Astro.site ?? new URL('https://example.com')).toString();
const schema = [
  ...gameSchema(siteUrl, { name: h1, description, path, genre, gameplayVariant, dateModified: updated.toISOString().slice(0, 10) }),
  breadcrumbs(siteUrl, crumbs),
  faqPage(faq),
  ...(steps ? [howTo(`How to play ${h1}`, steps)] : []),
];
---
<BaseLayout {title} {description} {path} schema={schema} compact>
  <div class="mx-auto max-w-6xl px-4 pt-3">
    <Breadcrumbs {crumbs} />
    <h1 class="mt-2 text-2xl font-bold sm:text-3xl">{h1}</h1>
  </div>

  <GameIsland client:load layoutSlug={layoutSlug} />

  <article class="mx-auto max-w-3xl px-4 pt-8">
    <p class="text-lg leading-relaxed">{intro}</p>
    {steps && <HowToPlay steps={steps} title={stepsTitle} />}
    <Faq items={faq} />
    <p class="mt-6 text-xs text-muted">Last updated <time datetime={updated.toISOString().slice(0, 10)}>{updated.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time></p>
  </article>

  <div class="mx-auto max-w-6xl px-4">
    <MoreGamesRail currentLayout={layoutSlug} />
  </div>
</BaseLayout>
