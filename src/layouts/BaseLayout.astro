---
import Seo from '../components/seo/Seo.astro';
import QuickSwitch from '../components/content/QuickSwitch.astro';
import Logo from '../components/Logo.astro';
import AdSlot from '../components/site/AdSlot.astro';
import Consent from '../components/site/Consent.astro';
import { CONFIG, FEATURES, SITE } from '../data/site';
import type { JsonLd } from '../lib/seo/schema';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image: string;
  imageAlt: string;
  noindex?: boolean;
  jsonLd?: JsonLd;
  /** Show the "More classic games" bar (off on pages that already list every game). */
  quickSwitch?: boolean;
  type?: 'website' | 'article';
  /** A game page that others may embed: inside an iframe it shows only the game (see .embedded in global.css). */
  embeddable?: boolean;
}

const { quickSwitch = true, embeddable = false, ...props } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { href: '/cards/', label: 'Mahjong & Cards' },
  { href: '/board/', label: 'Board Games' },
  { href: '/puzzles/', label: 'Puzzles & Word' },
  { href: '/arcade/', label: 'Arcade' },
  { href: '/games/', label: 'All games' },
  { href: '/blog/', label: 'Guides' },
];
const year = new Date().getFullYear();
/** Which hub a page belongs to, so the menu shows where you are. */
const HUB_OF: [string, string][] = [
  ['/cards/', '/cards/'],
  ['/mahjong/', '/cards/'],
  ['/solitaire/', '/cards/'],
  ['/board/', '/board/'],
  ['/puzzles/', '/puzzles/'],
  ['/sudoku/', '/puzzles/'],
  ['/minesweeper/', '/puzzles/'],
  ['/word-guess/', '/puzzles/'],
  ['/arcade/', '/arcade/'],
  ['/games/', '/games/'],
  ['/blog/', '/blog/'],
];
const current = HUB_OF.find(([prefix]) => path.startsWith(prefix))?.[1];
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <Seo {...props} />
    <meta name="theme-color" content={SITE.themeColor} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    {CONFIG.gscVerification && <meta name="google-site-verification" content={CONFIG.gscVerification} />}
    {CONFIG.bingVerification && <meta name="msvalidate.01" content={CONFIG.bingVerification} />}
    <Consent part="head" />
    {embeddable && <script is:inline>if (self !== top) document.documentElement.classList.add('embedded');</script>}
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-card focus:px-3 focus:py-2 focus:rounded-md">
      Skip to content
    </a>
    <header class="h-(--header-h) border-b border-border bg-card">
      <div class="container-page h-full flex items-center justify-between gap-4">
        <a href="/" class="no-underline text-fg" aria-label={`${SITE.name} home`}>
          <Logo size={32} />
        </a>
        <div class="flex items-center gap-2">
        <a href="/daily/" class="header-daily" aria-current={path.startsWith('/daily/') ? 'page' : undefined}>
          <span aria-hidden="true">★</span> Daily
        </a>
        <nav aria-label="Main" class="relative">
          <details class="nav-menu lg:hidden">
            <summary class="btn">Games</summary>
            <ul class="nav-menu-list">
              {
                nav.map((item) => (
                  <li>
                    <a href={item.href} aria-current={item.href === current ? 'page' : undefined}>
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </details>
          <ul class="hidden lg:flex items-center gap-1 text-base">
            {
              nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="px-2 py-2 rounded-md hover:text-brand"
                    aria-current={item.href === current ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        </div>
      </div>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>
    {quickSwitch && <div class="container-page"><AdSlot variant="game" /></div>}
    {quickSwitch && <QuickSwitch current={path} />}

    <footer class="site-footer border-t border-border bg-card mt-12">
      <div class="container-page py-8 grid gap-8 sm:grid-cols-[1.4fr_1fr_1fr_1fr] text-sm">
        <div>
          <a href="/" class="no-underline text-fg" aria-label={`${SITE.name} home`}>
            <Logo size={28} />
          </a>
          <p class="text-muted mt-3 max-w-xs">34 classic games that play instantly in your browser. {FEATURES.ads ? 'No sign-up, no download.' : 'No ads, no sign-up, no download.'}</p>
        </div>
        <nav aria-label="Game hubs">
          <p class="footer-head">Games</p>
          <ul>
            <li><a href="/cards/">Mahjong &amp; card games</a></li>
            <li><a href="/board/">Board games</a></li>
            <li><a href="/puzzles/">Puzzles &amp; word games</a></li>
            <li><a href="/arcade/">Arcade games</a></li>
            <li><a href="/games/">All games</a></li>
            <li><a href="/blog/">Strategy guides</a></li>
          </ul>
        </nav>
        <nav aria-label="Popular games">
          <p class="footer-head">Popular</p>
          <ul>
            <li><a href="/mahjong/">Mahjong Solitaire</a></li>
            <li><a href="/solitaire/">Solitaire</a></li>
            <li><a href="/board/chess/">Chess</a></li>
            <li><a href="/sudoku/">Sudoku</a></li>
            <li><a href="/word-guess/">Word Guess</a></li>
            <li><a href="/daily/">Daily challenges</a></li>
          </ul>
        </nav>
        <nav aria-label="About this site">
          <p class="footer-head">Site</p>
          <ul>
            <li><a href="/stats/">Your stats</a></li>
            <li><a href="/about/">About</a></li>
            <li><a href="/privacy/">Privacy</a></li>
            <li><a href="/terms/">Terms of use</a></li>
            {FEATURES.consent && <li><a href="/privacy/" data-privacy-choices>Privacy choices</a></li>}
          </ul>
        </nav>
      </div>
      <p class="container-page pb-8 text-xs text-muted">© {year} {SITE.name} · {SITE.domain}</p>
    </footer>
    <Consent part="body" />
    {
      import.meta.env.PROD && (
        <script is:inline>
          if ('serviceWorker' in navigator) addEventListener('load', function () { navigator.serviceWorker.register('/sw.js').catch(function () {}); });
        </script>
      )
    }
  </body>
</html>
