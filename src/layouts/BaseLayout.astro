---
import Seo from '../components/seo/Seo.astro';
import QuickSwitch from '../components/content/QuickSwitch.astro';
import Logo from '../components/Logo.astro';
import NavIcon, { type NavIconName } from '../components/site/NavIcon.astro';
import AdSlot from '../components/site/AdSlot.astro';
import Consent from '../components/site/Consent.astro';
import { CONFIG, FEATURES, SITE } from '../data/site';
import type { JsonLd } from '../lib/seo/schema';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image: string;
  imageAlt: string;
  noindex?: boolean;
  jsonLd?: JsonLd;
  /** Show the "More classic games" bar (off on pages that already list every game). */
  quickSwitch?: boolean;
  type?: 'website' | 'article';
  /** A game page that others may embed: inside an iframe it shows only the game (see .embedded in global.css). */
  embeddable?: boolean;
}

const { quickSwitch = true, embeddable = false, ...props } = Astro.props;
const path = Astro.url.pathname;
const nav: { href: string; label: string; icon: NavIconName }[] = [
  { href: '/cards/', label: 'Mahjong & Cards', icon: 'cards' },
  { href: '/board/', label: 'Board Games', icon: 'board' },
  { href: '/puzzles/', label: 'Puzzles & Word', icon: 'puzzles' },
  { href: '/arcade/', label: 'Arcade', icon: 'arcade' },
  { href: '/games/', label: 'All Games', icon: 'all' },
  { href: '/blog/', label: 'Guides', icon: 'guides' },
];
const year = new Date().getFullYear();
/** Which hub a page belongs to, so the menu shows where you are. */
const HUB_OF: [string, string][] = [
  ['/cards/', '/cards/'],
  ['/mahjong/', '/cards/'],
  ['/solitaire/', '/cards/'],
  ['/board/', '/board/'],
  ['/puzzles/', '/puzzles/'],
  ['/sudoku/', '/puzzles/'],
  ['/minesweeper/', '/puzzles/'],
  ['/word-guess/', '/puzzles/'],
  ['/arcade/', '/arcade/'],
  ['/games/', '/games/'],
  ['/blog/', '/blog/'],
];
const current = HUB_OF.find(([prefix]) => path.startsWith(prefix))?.[1];
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- Saved theme before first paint (no flash); with nothing saved the CSS follows the system setting. -->
    <script is:inline>try{var t=localStorage.getItem('og:theme');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t}catch(e){}</script>
    <Seo {...props} />
    <meta name="theme-color" content={SITE.themeColor} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    {CONFIG.gscVerification && <meta name="google-site-verification" content={CONFIG.gscVerification} />}
    {CONFIG.bingVerification && <meta name="msvalidate.01" content={CONFIG.bingVerification} />}
    <Consent part="head" />
    {embeddable && <script is:inline>if (self !== top) document.documentElement.classList.add('embedded');</script>}
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-card focus:px-3 focus:py-2 focus:rounded-md">
      Skip to content
    </a>
    <header class="site-header h-(--header-h) border-b border-border bg-card">
      <div class="container-page h-full flex items-center justify-between gap-2">
        <a href="/" class="no-underline text-fg shrink-0" aria-label={`${SITE.name} home`}>
          <Logo size={32} compact />
        </a>
        <div class="flex items-center gap-1.5 sm:gap-2 min-w-0">
          <a href="/daily/" class="header-daily" aria-current={path.startsWith('/daily/') ? 'page' : undefined}>
            <NavIcon name="daily" /> Daily
          </a>
          <nav aria-label="Main" class="relative">
            <details class="nav-menu xl:hidden">
              <summary class="btn nav-menu-btn">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
                Games
              </summary>
              <ul class="nav-menu-list">
                {
                  nav.map((item) => (
                    <li>
                      <a href={item.href} aria-current={item.href === current ? 'page' : undefined}>
                        <NavIcon name={item.icon} /> {item.label}
                      </a>
                    </li>
                  ))
                }
                <li class="nav-menu-theme">
                  <button type="button" class="theme-row" data-theme-toggle aria-pressed="false">
                    <NavIcon name="moon" class="theme-moon" /><NavIcon name="sun" class="theme-sun" />
                    <span class="theme-label-dark">Dark mode</span><span class="theme-label-light">Light mode</span>
                  </button>
                </li>
              </ul>
            </details>
            <ul class="nav-pills hidden xl:flex">
              {
                nav.map((item) => (
                  <li>
                    <a href={item.href} class="nav-pill" aria-current={item.href === current ? 'page' : undefined}>
                      <NavIcon name={item.icon} />
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <button type="button" class="theme-toggle" data-theme-toggle aria-pressed="false" aria-label="Dark mode" title="Switch light / dark mode">
            <NavIcon name="moon" size={18} class="theme-moon" /><NavIcon name="sun" size={18} class="theme-sun" />
          </button>
        </div>
      </div>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>
    {quickSwitch && <div class="container-page"><AdSlot variant="game" /></div>}
    {quickSwitch && <QuickSwitch current={path} />}

    <footer class="site-footer border-t border-border bg-card mt-12">
      <div class="container-page py-8 grid gap-8 sm:grid-cols-[1.4fr_1fr_1fr_1fr] text-sm">
        <div>
          <a href="/" class="no-underline text-fg" aria-label={`${SITE.name} home`}>
            <Logo size={28} />
          </a>
          <p class="text-muted mt-3 max-w-xs">34 classic games that play instantly in your browser. {FEATURES.ads ? 'No sign-up, no download.' : 'No ads, no sign-up, no download.'}</p>
        </div>
        <nav aria-label="Game hubs">
          <p class="footer-head">Games</p>
          <ul>
            <li><a href="/cards/">Mahjong &amp; card games</a></li>
            <li><a href="/board/">Board games</a></li>
            <li><a href="/puzzles/">Puzzles &amp; word games</a></li>
            <li><a href="/arcade/">Arcade games</a></li>
            <li><a href="/games/">All games</a></li>
            <li><a href="/blog/">Strategy guides</a></li>
          </ul>
        </nav>
        <nav aria-label="Popular games">
          <p class="footer-head">Popular</p>
          <ul>
            <li><a href="/mahjong/">Mahjong Solitaire</a></li>
            <li><a href="/solitaire/">Solitaire</a></li>
            <li><a href="/board/chess/">Chess</a></li>
            <li><a href="/sudoku/">Sudoku</a></li>
            <li><a href="/word-guess/">Word Guess</a></li>
            <li><a href="/daily/">Daily challenges</a></li>
          </ul>
        </nav>
        <nav aria-label="About this site">
          <p class="footer-head">Site</p>
          <ul>
            <li><a href="/stats/">Your stats</a></li>
            <li><a href="/about/">About</a></li>
            <li><a href="/privacy/">Privacy</a></li>
            <li><a href="/terms/">Terms of use</a></li>
            {FEATURES.consent && <li><a href="/privacy/" data-privacy-choices>Privacy choices</a></li>}
          </ul>
        </nav>
      </div>
      <p class="container-page pb-8 text-xs text-muted">© {year} {SITE.name} · {SITE.domain}</p>
    </footer>
    <Consent part="body" />
    <script is:inline>
      (function () {
        var d = document.documentElement, mq = matchMedia('(prefers-color-scheme: dark)');
        var dark = function () { return (d.dataset.theme || (mq.matches ? 'dark' : 'light')) === 'dark'; };
        var sync = function () { document.querySelectorAll('[data-theme-toggle]').forEach(function (b) { b.setAttribute('aria-pressed', dark()); }); };
        document.querySelectorAll('[data-theme-toggle]').forEach(function (b) {
          b.addEventListener('click', function () {
            var t = dark() ? 'light' : 'dark';
            d.dataset.theme = t;
            try { localStorage.setItem('og:theme', t); } catch (e) {}
            sync();
          });
        });
        mq.addEventListener('change', sync);
        sync();
      })();
    </script>
    {
      import.meta.env.PROD && (
        <script is:inline>
          if ('serviceWorker' in navigator) addEventListener('load', function () { navigator.serviceWorker.register('/sw.js').catch(function () {}); });
        </script>
      )
    }
  </body>
</html>
