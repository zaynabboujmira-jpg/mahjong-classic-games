---
import Seo from '../components/seo/Seo.astro';
import { SITE } from '../data/site';
import type { JsonLd } from '../lib/seo/schema';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image: string;
  imageAlt: string;
  noindex?: boolean;
  jsonLd?: JsonLd;
}

const props = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { href: '/mahjong/', label: 'Mahjong' },
  { href: '/mahjong/hong-kong/', label: '4-Player Mahjong' },
  { href: '/solitaire/', label: 'Solitaire' },
  { href: '/sudoku/', label: 'Sudoku' },
  { href: '/minesweeper/', label: 'Minesweeper' },
  { href: '/games/', label: 'All games' },
];
const year = new Date().getFullYear();
/** The nav item for this page: the 4-player tables share one item; otherwise the longest matching prefix. */
const tableVariants = ['/mahjong/hong-kong/', '/mahjong/american/', '/mahjong/chinese/'];
const current = tableVariants.some((v) => path.startsWith(v))
  ? '/mahjong/hong-kong/'
  : nav.filter((i) => path.startsWith(i.href)).sort((a, b) => b.href.length - a.href.length)[0]?.href;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <Seo {...props} />
    <meta name="theme-color" content={SITE.themeColor} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-card focus:px-3 focus:py-2 focus:rounded-md">
      Skip to content
    </a>
    <header class="h-(--header-h) border-b border-border bg-card">
      <div class="container-page h-full flex items-center justify-between gap-4">
        <a href="/" class="flex items-center gap-2 font-extrabold text-lg tracking-tight no-underline text-fg">
          <svg width="28" height="28" viewBox="0 0 32 32" aria-hidden="true">
            <rect x="3" y="6" width="20" height="24" rx="4" fill="#b3a27c" />
            <rect x="7" y="2" width="20" height="24" rx="4" fill="#fbf6e9" stroke="#0f5c4a" stroke-width="2" />
            <text x="17" y="19.5" text-anchor="middle" font-size="13" font-weight="700" fill="#c2272d" font-family="serif">中</text>
          </svg>
          <span>{SITE.shortName}<span class="text-muted font-semibold hidden sm:inline"> &amp; Classic Games</span></span>
        </a>
        <nav aria-label="Main" class="relative">
          <details class="nav-menu lg:hidden">
            <summary class="btn">Games</summary>
            <ul class="nav-menu-list">
              {
                nav.map((item) => (
                  <li>
                    <a href={item.href} aria-current={item.href === current ? 'page' : undefined}>
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </details>
          <ul class="hidden lg:flex items-center gap-1 xl:gap-3 text-base">
            {
              nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="px-2 py-2 rounded-md hover:text-brand"
                    aria-current={item.href === current ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-border bg-card mt-12">
      <div class="container-page py-8 text-sm text-muted flex flex-col sm:flex-row gap-4 justify-between">
        <p>© {year} {SITE.name}. Free to play, no sign-up.</p>
        <ul class="flex gap-4">
          <li><a class="hover:text-brand" href="/mahjong/">Mahjong layouts</a></li>
          <li><a class="hover:text-brand" href="/mahjong/hong-kong/">4-player Mahjong</a></li>
          <li><a class="hover:text-brand" href="/solitaire/klondike/">Klondike Solitaire</a></li>
          <li><a class="hover:text-brand" href="/sudoku/">Sudoku</a></li>
          <li><a class="hover:text-brand" href="/minesweeper/">Minesweeper</a></li>
          <li><a class="hover:text-brand" href="/about/">About</a></li>
          <li><a class="hover:text-brand" href="/privacy/">Privacy</a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>
